<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>心智圖工具</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#eef2f6;--dot:#cdd6e0;--surface:#ffffff;--text:#1d2733;--muted:#66758a;
  --bar:#ffffffee;--line:#d5dce5;--root:#1f3a5f;--roottext:#ffffff;--accent:#2f6fed;
  --c0:#2f6fed;--c1:#13a08a;--c2:#e08a1e;--c3:#c8407a;--c4:#7a56d6;--c5:#4a9a2c;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#12171e;--dot:#26303c;--surface:#1c2430;--text:#e6ecf3;--muted:#8d9db1;
  --bar:#1a222cee;--line:#2e3a48;--root:#8fb4f5;--roottext:#10213a;--accent:#6b9bff;
  --c0:#6b9bff;--c1:#3cc7ae;--c2:#f0a94a;--c3:#ee7aa8;--c4:#a58bf0;--c5:#7fc95f;}}
:root[data-theme="dark"]{
  --bg:#12171e;--dot:#26303c;--surface:#1c2430;--text:#e6ecf3;--muted:#8d9db1;
  --bar:#1a222cee;--line:#2e3a48;--root:#8fb4f5;--roottext:#10213a;--accent:#6b9bff;
  --c0:#6b9bff;--c1:#3cc7ae;--c2:#f0a94a;--c3:#ee7aa8;--c4:#a58bf0;--c5:#7fc95f;}
html,body{height:100%;margin:0;overflow:hidden}
body{background:var(--bg);color:var(--text);font-family:"Noto Sans TC","PingFang TC","Microsoft JhengHei",system-ui,sans-serif;-webkit-user-select:none;user-select:none}
#stage{position:absolute;inset:0;background-image:radial-gradient(var(--dot) 1px,transparent 1px);background-size:22px 22px;touch-action:none;cursor:grab}
#stage.pan{cursor:grabbing}
svg{width:100%;height:100%;display:block}
.node rect{fill:var(--surface);stroke-width:2;transition:stroke-width .12s}
.node text{fill:var(--text);font-size:15px;pointer-events:none}
.node.root rect{stroke:none}
.node.root text{fill:var(--roottext);font-size:18px;font-weight:700}
.node.sel rect{stroke-width:4}
.node{cursor:pointer}
.tog circle{fill:var(--surface);stroke-width:2}
.tog text{fill:var(--muted);font-size:12px;font-weight:700;text-anchor:middle}
.tog{cursor:pointer}
#bar{position:fixed;left:50%;transform:translateX(-50%);top:calc(env(safe-area-inset-top,0px) + 10px);display:flex;gap:4px;flex-wrap:wrap;justify-content:center;max-width:calc(100% - 16px);padding:6px;border-radius:12px;background:var(--bar);border:1px solid var(--line);backdrop-filter:blur(8px);z-index:5}
button{font:inherit;font-size:14px;color:var(--text);background:transparent;border:1px solid transparent;border-radius:8px;padding:7px 11px;cursor:pointer;white-space:nowrap}
button:hover{background:var(--bg);border-color:var(--line)}
button:focus-visible,#ed:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
button.primary{background:var(--accent);color:#fff}
button.primary:hover{background:var(--accent);filter:brightness(1.08)}
button:disabled{opacity:.4;cursor:default}
.sep{width:1px;background:var(--line);margin:4px 2px}
#ed{position:fixed;display:none;z-index:8;font:inherit;font-size:15px;color:var(--text);background:var(--surface);border:2px solid var(--accent);border-radius:10px;padding:0 12px;box-sizing:border-box;-webkit-user-select:text;user-select:text}
#hint{position:fixed;left:12px;bottom:calc(env(safe-area-inset-bottom,0px) + 10px);font-size:12.5px;line-height:1.7;color:var(--muted);background:var(--bar);border:1px solid var(--line);border-radius:10px;padding:8px 12px;z-index:4;max-width:calc(100% - 24px)}
#hint kbd{font:inherit;font-weight:700;color:var(--text)}
@media (max-width:640px){#hint{display:none}}
dialog{border:1px solid var(--line);border-radius:14px;background:var(--surface);color:var(--text);padding:18px;width:min(520px,calc(100% - 32px));font:inherit}
dialog::backdrop{background:#0008}
dialog h2{margin:0 0 6px;font-size:17px}
dialog p{margin:0 0 10px;font-size:13.5px;color:var(--muted);line-height:1.6}
textarea{width:100%;height:220px;box-sizing:border-box;resize:vertical;font:12.5px/1.5 ui-monospace,Menlo,Consolas,monospace;color:var(--text);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px;-webkit-user-select:text;user-select:text}
.row{display:flex;gap:8px;justify-content:flex-end;margin-top:12px;flex-wrap:wrap}
#toast{position:fixed;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 56px);transform:translateX(-50%);background:var(--text);color:var(--bg);padding:8px 14px;border-radius:999px;font-size:13.5px;opacity:0;pointer-events:none;transition:opacity .2s;z-index:20}
#toast.on{opacity:1}
</style>
</head>
<body>
<div id="stage"><svg id="svg" role="application" aria-label="心智圖畫布"><g id="vp"></g></svg></div>
<div id="bar">
  <button id="bChild" class="primary" title="新增子節點（Tab）">＋子節點</button>
  <button id="bSib" title="新增同層節點（Enter）">＋同層</button>
  <button id="bEdit" title="編輯文字（F2 或雙擊）">編輯</button>
  <button id="bDel" title="刪除節點（Delete）">刪除</button>
  <span class="sep"></span>
  <button id="bUndo" title="復原（Ctrl+Z）">復原</button>
  <button id="bFit" title="置中並縮放至適當大小">置中</button>
  <button id="bZin" aria-label="放大">＋</button>
  <button id="bZout" aria-label="縮小">－</button>
  <span class="sep"></span>
  <button id="bIO">匯出／匯入</button>
  <button id="bTheme" aria-label="切換深淺色">◐</button>
</div>
<div id="hint">
  <kbd>Tab</kbd> 新增子節點　<kbd>Enter</kbd> 新增同層　<kbd>F2</kbd>／雙擊 編輯<br>
  <kbd>Delete</kbd> 刪除　<kbd>方向鍵</kbd> 移動選取　<kbd>空白鍵</kbd> 收合／展開<br>
  拖曳空白處平移，滾輪縮放
</div>
<input id="ed" aria-label="節點文字" maxlength="80">
<div id="toast"></div>

<dialog id="dlg">
  <h2>匯出／匯入</h2>
  <p>下方是目前心智圖的 JSON。複製後可自行保存；貼上其他內容再按「匯入」即可載入。</p>
  <textarea id="ta" spellcheck="false"></textarea>
  <div class="row">
    <button id="dCopy">複製</button>
    <button id="dImp" class="primary">匯入</button>
    <button id="dClose">關閉</button>
  </div>
</dialog>

<script>
(function(){
var NS="http://www.w3.org/2000/svg", KEY="mindmap-v1";
var H=38, RH=46, GAP=12, HGAP=64, PAD=18;
var uid=1, root, selId, view={x:80,y:0,k:1}, undoStack=[], editing=null;
var svg=document.getElementById("svg"), vp=document.getElementById("vp"), stage=document.getElementById("stage");
var ed=document.getElementById("ed"), toastEl=document.getElementById("toast");
var cv=document.createElement("canvas").getContext("2d");

function mk(text){return {id:"n"+(uid++),text:text,children:[],collapsed:false};}
function sample(){
  var r=mk("我的心智圖");
  var a=mk("想法"), b=mk("任務"), c=mk("資源"), d=mk("下一步");
  a.children=[mk("主題發想"),mk("關鍵問題")];
  b.children=[mk("本週待辦"),mk("長期目標")];
  c.children=[mk("參考文章"),mk("工具清單")];
  r.children=[a,b,c,d]; return r;
}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c];});}
function toast(t){toastEl.textContent=t;toastEl.classList.add("on");clearTimeout(toast.t);toast.t=setTimeout(function(){toastEl.classList.remove("on");},1600);}

/* ---------- 資料操作 ---------- */
function find(n,id,parent){
  if(n.id===id) return {node:n,parent:parent||null};
  for(var i=0;i<n.children.length;i++){var r=find(n.children[i],id,n); if(r) return r;}
  return null;
}
function save(){try{localStorage.setItem(KEY,JSON.stringify({root:root,uid:uid,sel:selId}));}catch(e){}}
function snapshot(){
  undoStack.push(JSON.stringify(root)); if(undoStack.length>60) undoStack.shift();
}
function fixUid(n){var m=parseInt(String(n.id).slice(1),10)||0; if(m>=uid) uid=m+1; n.children.forEach(fixUid);}
function load(){
  try{
    var s=JSON.parse(localStorage.getItem(KEY));
    if(s&&s.root&&Array.isArray(s.root.children)){root=s.root;uid=s.uid||1;selId=s.sel;fixUid(root);return;}
  }catch(e){}
  root=sample(); selId=root.id;
}
function commit(){render();save();}

/* ---------- 版面 ---------- */
function measure(n,isRoot){
  cv.font=(isRoot?"700 18px ":"15px ")+'"Noto Sans TC","PingFang TC","Microsoft JhengHei",sans-serif';
  return Math.max(isRoot?96:64,Math.ceil(cv.measureText(n.text).width)+PAD*2);
}
function sizeOf(n,depth){
  n.w=measure(n,depth===0); n.h=depth===0?RH:H;
  var vis=n.collapsed?[]:n.children, tot=0;
  vis.forEach(function(c,i){sizeOf(c,depth+1);tot+=c.sh+(i?GAP:0);});
  n.sh=Math.max(n.h,tot); if(!vis.length) n.sh=n.h;
  n.ctot=tot;
}
function place(n,x,top,depth,color){
  n.x=x; n.depth=depth; n.color=color;
  var vis=n.collapsed?[]:n.children;
  if(!vis.length){n.y=top+n.sh/2;return;}
  var cy=top+(n.sh-n.ctot)/2;
  vis.forEach(function(c,i){
    place(c,x+n.w+HGAP,cy,depth+1,depth===0?"var(--c"+(i%6)+")":color);
    cy+=c.sh+GAP;
  });
  n.y=(vis[0].y+vis[vis.length-1].y)/2;
}

/* ---------- 繪製 ---------- */
function render(){
  sizeOf(root,0); place(root,0,0,0,"var(--root)");
  var links="",nodes="";
  (function walk(n){
    var vis=n.collapsed?[]:n.children;
    vis.forEach(function(c){
      var x1=n.x+n.w,y1=n.y,x2=c.x,y2=c.y,mx=(x1+x2)/2;
      links+='<path d="M'+x1+' '+y1+'C'+mx+' '+y1+' '+mx+' '+y2+' '+x2+' '+y2+'" fill="none" stroke="'+c.color+'" stroke-width="'+(c.depth===1?3:2)+'" stroke-linecap="round" opacity=".75"/>';
      walk(c);
    });
    var sel=n.id===selId, isRoot=n.depth===0;
    nodes+='<g class="node'+(isRoot?" root":"")+(sel?" sel":"")+'" data-id="'+n.id+'">'+
      '<rect x="'+n.x+'" y="'+(n.y-n.h/2)+'" width="'+n.w+'" height="'+n.h+'" rx="'+(n.h/2)+'"'+
      (isRoot?' style="fill:var(--root)"':' style="stroke:'+n.color+'"')+'/>'+
      '<text x="'+(n.x+n.w/2)+'" y="'+n.y+'" text-anchor="middle" dominant-baseline="central">'+esc(n.text)+'</text></g>';
    if(n.children.length){
      var tx=n.x+n.w+(n.collapsed?0:0)+14, col=isRoot?"var(--root)":n.color;
      nodes+='<g class="tog" data-tog="'+n.id+'"><circle cx="'+tx+'" cy="'+n.y+'" r="10" style="stroke:'+col+'"/>'+
        '<text x="'+tx+'" y="'+n.y+'" dominant-baseline="central">'+(n.collapsed?n.children.length:"−")+'</text></g>';
    }
  })(root);
  vp.innerHTML=links+nodes;
  applyView();
  document.getElementById("bUndo").disabled=!undoStack.length;
  document.getElementById("bDel").disabled=selId===root.id;
  document.getElementById("bSib").disabled=selId===root.id;
}
function applyView(){vp.setAttribute("transform","translate("+view.x+","+view.y+") scale("+view.k+")");}
function fit(){
  var minY=1e9,maxY=-1e9,maxX=0;
  (function w(n){minY=Math.min(minY,n.y-n.h/2);maxY=Math.max(maxY,n.y+n.h/2);maxX=Math.max(maxX,n.x+n.w+30);(n.collapsed?[]:n.children).forEach(w);})(root);
  var W=stage.clientWidth,Hh=stage.clientHeight;
  var k=Math.min(1.2,Math.max(.3,Math.min((W-120)/maxX,(Hh-200)/(maxY-minY))));
  view.k=k; view.x=60; view.y=Hh/2-((minY+maxY)/2)*k+20; applyView();
}
function zoomAt(f,cx,cy){
  var k=Math.min(2.5,Math.max(.25,view.k*f)); f=k/view.k;
  view.x=cx-(cx-view.x)*f; view.y=cy-(cy-view.y)*f; view.k=k; applyView();
}

/* ---------- 選取／編輯 ---------- */
function select(id){selId=id;render();save();}
function startEdit(id){
  var r=find(root,id); if(!r) return; var n=r.node;
  selId=id; render();
  var rect=vp.querySelector('[data-id="'+id+'"] rect').getBoundingClientRect();
  var w=Math.max(rect.width,150);
  ed.style.display="block"; ed.style.left=(rect.left+rect.width/2-w/2)+"px"; ed.style.top=rect.top+"px";
  ed.style.width=w+"px"; ed.style.height=rect.height+"px"; ed.style.textAlign="center";
  ed.value=n.text; editing=id; ed.focus(); ed.select();
}
function endEdit(ok){
  if(!editing) return; var id=editing; editing=null; ed.style.display="none";
  var v=ed.value.trim(), r=find(root,id);
  if(ok&&v&&r&&v!==r.node.text){snapshot();r.node.text=v;commit();}
  stage.focus&&0;
}
ed.addEventListener("keydown",function(e){
  e.stopPropagation();
  if(e.key==="Enter"&&!e.isComposing){e.preventDefault();endEdit(true);}
  else if(e.key==="Escape"){endEdit(false);}
  else if(e.key==="Tab"&&!e.isComposing){e.preventDefault();endEdit(true);addChild();}
});
ed.addEventListener("blur",function(){endEdit(true);});

function addChild(){
  var r=find(root,selId); if(!r) return; snapshot();
  var c=mk("新節點"); r.node.children.push(c); r.node.collapsed=false; selId=c.id; commit(); startEdit(c.id);
}
function addSibling(){
  var r=find(root,selId); if(!r||!r.parent) return; snapshot();
  var c=mk("新節點"), i=r.parent.children.indexOf(r.node);
  r.parent.children.splice(i+1,0,c); selId=c.id; commit(); startEdit(c.id);
}
function del(){
  var r=find(root,selId); if(!r||!r.parent) return; snapshot();
  var i=r.parent.children.indexOf(r.node); r.parent.children.splice(i,1);
  selId=(r.parent.children[i]||r.parent.children[i-1]||r.parent).id; commit();
}
function toggle(id){
  var r=find(root,id); if(!r||!r.node.children.length) return; snapshot();
  r.node.collapsed=!r.node.collapsed; commit();
}
function undo(){
  if(!undoStack.length) return; root=JSON.parse(undoStack.pop());
  if(!find(root,selId)) selId=root.id; commit(); toast("已復原");
}
function nav(dir){
  var r=find(root,selId); if(!r) return; var n=r.node, p=r.parent;
  if(dir==="Left"&&p) select(p.id);
  else if(dir==="Right"&&n.children.length&&!n.collapsed) select(n.children[0].id);
  else if((dir==="Up"||dir==="Down")&&p){
    var i=p.children.indexOf(n)+(dir==="Up"?-1:1);
    if(p.children[i]) select(p.children[i].id);
  }
}

/* ---------- 互動 ---------- */
var drag=null, pts={}, pinch=null;
stage.addEventListener("pointerdown",function(e){
  if(editing) endEdit(true);
  pts[e.pointerId]={x:e.clientX,y:e.clientY};
  var ids=Object.keys(pts);
  if(ids.length===2){
    var a=pts[ids[0]],b=pts[ids[1]];
    pinch={d:Math.hypot(a.x-b.x,a.y-b.y)}; drag=null; return;
  }
  var t=e.target.closest("[data-tog]");
  if(t){toggle(t.getAttribute("data-tog"));return;}
  var nd=e.target.closest("[data-id]");
  if(nd){select(nd.getAttribute("data-id"));drag=null;return;}
  drag={x:e.clientX,y:e.clientY,vx:view.x,vy:view.y};
  stage.classList.add("pan"); stage.setPointerCapture(e.pointerId);
});
stage.addEventListener("pointermove",function(e){
  if(!pts[e.pointerId]) return;
  pts[e.pointerId]={x:e.clientX,y:e.clientY};
  var ids=Object.keys(pts);
  if(pinch&&ids.length===2){
    var a=pts[ids[0]],b=pts[ids[1]],d=Math.hypot(a.x-b.x,a.y-b.y);
    zoomAt(d/pinch.d,(a.x+b.x)/2,(a.y+b.y)/2); pinch.d=d; return;
  }
  if(drag){view.x=drag.vx+e.clientX-drag.x; view.y=drag.vy+e.clientY-drag.y; applyView();}
});
function up(e){delete pts[e.pointerId]; if(Object.keys(pts).length<2) pinch=null; drag=null; stage.classList.remove("pan");}
stage.addEventListener("pointerup",up); stage.addEventListener("pointercancel",up);
stage.addEventListener("wheel",function(e){e.preventDefault();zoomAt(e.deltaY<0?1.1:1/1.1,e.clientX,e.clientY);},{passive:false});
stage.addEventListener("dblclick",function(e){
  var nd=e.target.closest("[data-id]"); if(nd) startEdit(nd.getAttribute("data-id"));
});
document.addEventListener("keydown",function(e){
  if(editing||document.getElementById("dlg").open) return;
  var k=e.key;
  if((e.ctrlKey||e.metaKey)&&k.toLowerCase()==="z"){e.preventDefault();undo();}
  else if(k==="Tab"){e.preventDefault();addChild();}
  else if(k==="Enter"){e.preventDefault();addSibling();}
  else if(k==="F2"){e.preventDefault();startEdit(selId);}
  else if(k==="Delete"||k==="Backspace"){e.preventDefault();del();}
  else if(k===" "){e.preventDefault();toggle(selId);}
  else if(k.indexOf("Arrow")===0){e.preventDefault();nav(k.slice(5));}
});
window.addEventListener("resize",function(){if(editing) endEdit(true);});

function $(id){return document.getElementById(id);}
$("bChild").onclick=addChild; $("bSib").onclick=addSibling;
$("bEdit").onclick=function(){startEdit(selId);}; $("bDel").onclick=del;
$("bUndo").onclick=undo; $("bFit").onclick=fit;
$("bZin").onclick=function(){zoomAt(1.2,stage.clientWidth/2,stage.clientHeight/2);};
$("bZout").onclick=function(){zoomAt(1/1.2,stage.clientWidth/2,stage.clientHeight/2);};
$("bTheme").onclick=function(){
  var cur=document.documentElement.getAttribute("data-theme")||(matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light");
  document.documentElement.setAttribute("data-theme",cur==="dark"?"light":"dark");
};

/* ---------- 匯出／匯入 ---------- */
var dlg=$("dlg"), ta=$("ta");
function clean(n){return {text:n.text,collapsed:!!n.collapsed,children:n.children.map(clean)};}
function rebuild(o){
  if(!o||typeof o.text!=="string") throw new Error("格式錯誤");
  var n=mk(o.text.slice(0,80)); n.collapsed=!!o.collapsed;
  n.children=(Array.isArray(o.children)?o.children:[]).map(rebuild); return n;
}
$("bIO").onclick=function(){ta.value=JSON.stringify(clean(root),null,2);dlg.showModal();};
$("dClose").onclick=function(){dlg.close();};
$("dCopy").onclick=function(){
  ta.select();
  try{navigator.clipboard.writeText(ta.value).then(function(){toast("已複製");},function(){document.execCommand("copy");toast("已複製");});}
  catch(e){try{document.execCommand("copy");toast("已複製");}catch(_){toast("請手動複製");}}
};
$("dImp").onclick=function(){
  try{
    var n=rebuild(JSON.parse(ta.value)); snapshot(); root=n; selId=root.id; dlg.close(); commit(); fit(); toast("已匯入");
  }catch(e){toast("無法匯入：JSON 格式不正確");}
};

/* ---------- 啟動 ---------- */
load(); if(!find(root,selId)) selId=root.id;
render(); fit();
})();
</script>
</body>
</html>
